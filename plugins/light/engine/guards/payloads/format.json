[
  {
    "name": "says when the formatter rewrote the file",
    "event": "wrote",
    "settings": {
      "format": "python3 -c \"import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.write_text(p.read_text().rstrip()+chr(10))\" {file}"
    },
    "files": {
      "a.txt": "x   \n\n\n"
    },
    "call": {
      "path": "a.txt",
      "text": "x   \n\n\n"
    },
    "expect": "warn"
  },
  {
    "name": "stays silent when nothing changed",
    "event": "wrote",
    "settings": {
      "format": "python3 -c \"import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.write_text(p.read_text().rstrip()+chr(10))\" {file}"
    },
    "files": {
      "a.txt": "x\n"
    },
    "call": {
      "path": "a.txt",
      "text": "x\n"
    },
    "expect": "pass"
  },
  {
    "name": "says when the formatter failed",
    "event": "wrote",
    "settings": {
      "format": "false"
    },
    "files": {
      "a.txt": "x\n"
    },
    "call": {
      "path": "a.txt",
      "text": "x\n"
    },
    "expect": "warn"
  },
  {
    "name": "is off with no formatter set",
    "event": "wrote",
    "files": {
      "a.txt": "x   \n"
    },
    "call": {
      "path": "a.txt",
      "text": "x   \n"
    },
    "expect": "pass"
  },
  {
    "name": "passes a path the project excused",
    "event": "wrote",
    "settings": {
      "format": "python3 -c \"import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.write_text(p.read_text().rstrip()+chr(10))\" {file}",
      "skip": {
        "format": [
          "legacy/**"
        ]
      }
    },
    "files": {
      "legacy/a.txt": "x   \n"
    },
    "call": {
      "path": "legacy/a.txt",
      "text": "x   \n"
    },
    "expect": "pass"
  },
  {
    "name": "does not run a formatter nobody approved on this machine",
    "event": "wrote",
    "settings": {
      "format": "python3 -c \"import sys,pathlib;p=pathlib.Path(sys.argv[1]);p.write_text(p.read_text().rstrip()+chr(10))\" {file}"
    },
    "files": {
      "a.txt": "x   \n"
    },
    "call": {
      "path": "a.txt",
      "text": "x   \n"
    },
    "unapproved": true,
    "expect": "notice"
  }
