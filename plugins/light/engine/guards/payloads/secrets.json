[
  {
    "name": "blocks a GitHub token in a new file",
    "event": "write",
    "call": {
      "path": "src/config.py",
      "text": [
        "token = \"",
        "ghp_",
        {
          "repeat": "a",
          "times": 36
        },
        "\"\n"
      ]
    },
    "expect": "block"
  },
  {
    "name": "blocks an AWS access key",
    "event": "write",
    "call": {
      "path": "deploy.sh",
      "text": [
        "export AWS_ACCESS_KEY_ID=",
        "AKIA",
        "IOSFODNN7EXAMPLE",
        "\n"
      ]
    },
    "expect": "block"
  },
  {
    "name": "blocks a private key",
    "event": "write",
    "call": {
      "path": "key.pem",
      "text": [
        "-----BEGIN ",
        "RSA PRIVATE KEY-----\n"
      ]
    },
    "expect": "block"
  },
  {
    "name": "warns on a quoted value that only looks like a key",
    "event": "write",
    "call": {
      "path": "settings.py",
      "text": "api_key = \"9f8e7d6c5b4a39281706f5e4d3c2b1a0\"\n"
    },
    "expect": "warn"
  },
  {
    "name": "passes a placeholder",
    "event": "write",
    "call": {
      "path": "settings.py",
      "text": "api_key = \"your_api_key_goes_here_please\"\n"
    },
    "expect": "pass"
  },
  {
    "name": "passes a value read from the environment",
    "event": "write",
    "call": {
      "path": "settings.py",
      "text": "token = os.environ[\"GITHUB_TOKEN\"]\n"
    },
    "expect": "pass"
  },
  {
    "name": "passes a path the project excused",
    "event": "write",
    "settings": {
      "skip": {
        "secrets": [
          "fixtures/**"
        ]
      }
    },
    "call": {
      "path": "fixtures/key.txt",
      "text": [
        "token = \"",
        "ghp_",
        {
          "repeat": "a",
          "times": 36
        },
        "\"\n"
      ]
    },
    "expect": "pass"
  },
  {
    "name": "blocks a command that prints a secrets file",
    "event": "shell",
    "call": {
      "command": "cat .env"
    },
    "expect": "block"
  },
  {
    "name": "passes the example file",
    "event": "shell",
    "call": {
      "command": "cat .env.example"
    },
    "expect": "pass"
  },
  {
    "name": "blocks a command that prints a secret variable",
    "event": "shell",
    "call": {
      "command": "echo $OPENAI_API_KEY"
    },
    "expect": "block"
  },
  {
    "name": "warns on a dump of the whole environment",
    "event": "shell",
    "call": {
      "command": "printenv"
    },
    "expect": "warn"
  },
  {
    "name": "passes a check that prints nothing",
    "event": "shell",
    "call": {
      "command": "test -n \"$OPENAI_API_KEY\" && echo set"
    },
    "expect": "pass"
  }
]
