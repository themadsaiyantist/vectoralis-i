[
  {
    "name": "blocks a GitHub token in a new file",
    "event": "write",
    "call": {
      "path": "src/config.py",
      "text": [
        "token = \"",
        "ghp_",
        {
          "repeat": "a",
          "times": 36
        },
        "\"\n"
      ]
    },
    "expect": "block"
  },
  {
    "name": "blocks an AWS access key",
    "event": "write",
    "call": {
      "path": "deploy.sh",
      "text": [
        "export AWS_ACCESS_KEY_ID=",
        "AKIA",
        "IOSFODNN7EXAMPLE",
        "\n"
      ]
    },
    "expect": "block"
  },
  {
    "name": "blocks a private key",
    "event": "write",
    "call": {
      "path": "key.pem",
